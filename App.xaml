<Application x:Class="ShortcutManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:ShortcutManager"
             mc:Ignorable="po"
             ShutdownMode="OnExplicitShutdown"
             Startup="OnStartupHandler">
    <Application.Resources>
        <ResourceDictionary>
            <local:BoolToVisibilityConverter x:Key="BoolToVis" />

            <!-- 全局共享调色板（Freeze 后跨窗口复用零开销） -->
            <SolidColorBrush x:Key="Accent" Color="#2F6FED" po:Freeze="True" />
            <SolidColorBrush x:Key="AccentSoft" Color="#E7EFFE" po:Freeze="True" />
            <SolidColorBrush x:Key="Line" Color="#E1E5EE" po:Freeze="True" />
            <SolidColorBrush x:Key="Muted" Color="#7A869A" po:Freeze="True" />
            <SolidColorBrush x:Key="Hover" Color="#EAEEF7" po:Freeze="True" />
            <SolidColorBrush x:Key="Pressed" Color="#DCE4F5" po:Freeze="True" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
