<Window x:Class="ShortcutManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ShortcutManager.ViewModels"
        xmlns:local="clr-namespace:ShortcutManager"
        Title="快捷方式管理器"
        Height="580" Width="600"
        MinHeight="380" MinWidth="520"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        AllowDrop="True"
        Background="#F4F6FA"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        Foreground="#1F2430">

    <Window.Resources>
        <ResourceDictionary>

            <!-- ?? ===== 调色板 ===== -->
            <SolidColorBrush x:Key="Accent" Color="#2F6FED" />
            <SolidColorBrush x:Key="AccentSoft" Color="#E7EFFE" />
            <SolidColorBrush x:Key="Line" Color="#E1E5EE" />
            <SolidColorBrush x:Key="Muted" Color="#7A869A" />
            <SolidColorBrush x:Key="Hover" Color="#EAEEF7" />
            <SolidColorBrush x:Key="Pressed" Color="#DCE4F5" />

            <!-- ===== 底部工具条按钮 ===== -->
            <Style x:Key="BarButton" TargetType="Button">
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#3B4457" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="White" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#B9CDFA" />
                                    <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Pressed}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== 右键菜单 ===== -->
            <Style TargetType="ContextMenu">
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="{StaticResource Line}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="HasDropShadow" Value="True" />
                <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="MenuItem">
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="Foreground" Value="#1F2430" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" ContentSource="Header" RecognizesAccessKey="True"
                                                      VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="›" Margin="14,0,0,0" Foreground="{StaticResource Muted}"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding HasItems, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}" />
                                    <Popup x:Name="PART_Popup" Grid.Column="1"
                                           IsOpen="{TemplateBinding IsSubmenuOpen}"
                                           Placement="Right" HorizontalOffset="-6" VerticalOffset="-6"
                                           AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                                CornerRadius="8" Padding="4" Margin="0,0,10,10">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="14" ShadowDepth="1" Opacity="0.18" />
                                            </Border.Effect>
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MenuSeparator" TargetType="Separator">
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="8,4" />
                <Setter Property="Background" Value="{StaticResource Line}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Rectangle Height="1" Fill="{TemplateBinding Background}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== 标签栏翻页箭头（替代原生横向滚动条）===== -->
            <Style x:Key="TabArrow" TargetType="RepeatButton">
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="22" />
                <Setter Property="Margin" Value="1,0" />
                <Setter Property="Foreground" Value="#8A93A6" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Delay" Value="350" />
                <Setter Property="Interval" Value="70" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}" />
                                    <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Pressed}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.3" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== 分组 tab ===== -->
            <Style x:Key="GroupTab" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="#5A6478" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid>
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="7,7,0,0" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                                <!-- 拖拽插入指示 -->
                                <Border x:Name="DropLine" Width="3" HorizontalAlignment="Left" Margin="0,3,0,3"
                                        Background="{StaticResource Accent}" CornerRadius="2" Visibility="Collapsed" />
                                <Border x:Name="DropLineAfter" Width="3" HorizontalAlignment="Right" Margin="0,3,0,3"
                                        Background="{StaticResource Accent}" CornerRadius="2" Visibility="Collapsed" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="White" />
                                    <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsDragTarget}" Value="True">
                                    <Setter TargetName="DropLine" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDragTargetAfter}" Value="True">
                                    <Setter TargetName="DropLineAfter" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== 分组 tab 内联重命名输入框 ===== -->
            <Style x:Key="InlineEdit" TargetType="TextBox">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="White" />
                <Setter Property="Foreground" Value="#1F2430" />
                <Setter Property="Padding" Value="2,1" />
                <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource Accent}"
                                    BorderThickness="0,0,0,1.5" CornerRadius="2">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== 快捷方式磁贴 ===== -->
            <Style x:Key="Tile" TargetType="ListBoxItem">
                <Setter Property="Height" Value="92" />
                <Setter Property="Margin" Value="3" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid>
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="10"
                                        BorderBrush="Transparent" BorderThickness="1.5"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                                <!-- 拖拽插入指示 -->
                                <Border x:Name="DropLine" Width="3" HorizontalAlignment="Left" Margin="0,8,0,8"
                                        Background="{StaticResource Accent}" CornerRadius="2" Visibility="Collapsed" />
                                <Border x:Name="DropLineAfter" Width="3" HorizontalAlignment="Right" Margin="0,8,0,8"
                                        Background="{StaticResource Accent}" CornerRadius="2" Visibility="Collapsed" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FFFFFF" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#E3E9F6" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#B9CDFA" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsDragTarget}" Value="True">
                                    <Setter TargetName="DropLine" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDragTargetAfter}" Value="True">
                                    <Setter TargetName="DropLineAfter" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{x:Static local:MainWindow.MinimizeCommand}" />
        <KeyBinding Key="T" Modifiers="Control" Command="{x:Static local:MainWindow.NewGroupCommand}" />
        <KeyBinding Key="Delete" Command="{x:Static local:MainWindow.DeleteCommand}" />
        <KeyBinding Key="F2" Command="{x:Static local:MainWindow.RenameCommand}" />
        <KeyBinding Key="Q" Modifiers="Control" Command="{x:Static local:MainWindow.QuitCommand}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{x:Static local:MainWindow.MinimizeCommand}" />
    </Window.InputBindings>

    <Border BorderBrush="#D8DEEA" BorderThickness="1" Background="#F4F6FA">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============ 顶部：分组 tab ============ -->
            <Grid Grid.Row="0" Background="#F4F6FA" Margin="8,6,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 原生横向滚动条太丑：隐藏它，改用右侧的两个三角箭头翻页 -->
                <ScrollViewer x:Name="TabScroll" Grid.Column="0"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <ListBox x:Name="TabList"
                             ItemsSource="{Binding Groups}"
                             SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource GroupTab}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             AllowDrop="True"
                             MouseDoubleClick="TabList_MouseDoubleClick"
                             PreviewMouseLeftButtonDown="TabList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="TabList_PreviewMouseMove"
                             PreviewMouseLeftButtonUp="TabList_PreviewMouseLeftButtonUp"
                             DragOver="TabList_DragOver"
                             DragLeave="TabList_DragLeave"
                             Drop="TabList_Drop">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ShortcutGroupViewModel}">
                                <Grid>
                                    <TextBlock Text="{Binding TabTitle}" VerticalAlignment="Center"
                                               Visibility="{Binding IsNotRenaming, Converter={StaticResource BoolToVis}}" />
                                    <TextBox x:Name="TabRenameBox" Text="{Binding RenameBuffer, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InlineEdit}" MinWidth="60"
                                             Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}"
                                             IsVisibleChanged="RenameBox_IsVisibleChanged"
                                             KeyDown="RenameBox_KeyDown" LostFocus="RenameBox_LostFocus" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="新建分组" Click="NewGroup_Click" />
                                <MenuItem Header="重命名分组" Click="RenameGroup_Click" />
                                <Separator Style="{StaticResource MenuSeparator}" />
                                <MenuItem Header="删除分组" Click="DeleteGroup_Click" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </ScrollViewer>

                <!-- 分组多到一屏放不下时才出现；能继续滚的方向才可点 -->
                <StackPanel x:Name="TabArrows" Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="4,0,0,0" Visibility="Collapsed">
                    <RepeatButton x:Name="TabLeftButton" Style="{StaticResource TabArrow}"
                                  Click="TabLeft_Click" ToolTip="往前翻分组">
                        <Path Data="M 6,0 L 0,5 L 6,10 Z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}" />
                    </RepeatButton>
                    <RepeatButton x:Name="TabRightButton" Style="{StaticResource TabArrow}"
                                  Click="TabRight_Click" ToolTip="往后翻分组">
                        <Path Data="M 0,0 L 6,5 L 0,10 Z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}" />
                    </RepeatButton>
                </StackPanel>
            </Grid>

            <!-- ============ 中间：3 列网格 ============ -->
            <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="10" Margin="8,0,8,8" ClipToBounds="True">
                <Grid>
                    <ListBox x:Name="TileList"
                             ItemsSource="{Binding SelectedItems}"
                             SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Padding="8"
                             ItemContainerStyle="{StaticResource Tile}"
                             SelectionMode="Extended"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="False"
                             MouseDoubleClick="TileList_MouseDoubleClick"
                             KeyDown="TileList_KeyDown"
                             PreviewMouseLeftButtonDown="TileList_PreviewMouseLeftButtonDown"
                             PreviewMouseRightButtonDown="TileList_PreviewMouseRightButtonDown"
                             PreviewMouseMove="TileList_PreviewMouseMove"
                             PreviewMouseLeftButtonUp="TileList_PreviewMouseLeftButtonUp"
                             DragOver="TileList_DragOver"
                             DragLeave="TileList_DragLeave"
                             Drop="TileList_Drop"
                             AllowDrop="True">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- 一行固定四个：UniformGrid 四列自适应宽度，不会出现半截的第四列 -->
                                <UniformGrid Columns="4" HorizontalAlignment="Stretch" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ShortcutViewModel}">
                                <Grid Background="Transparent" ToolTip="{Binding Tooltip}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- 图标 -->
                                    <Image Grid.Row="0" Source="{Binding Icon}" Width="38" Height="38"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                        <Setter Property="Opacity" Value="0.35" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>

                                    <!-- 名字 -->
                                    <Grid Grid.Row="1" Margin="3,1,3,2">
                                        <TextBlock Text="{Binding Name}" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   MaxHeight="32" TextWrapping="Wrap" LineHeight="15"
                                                   FontSize="12"
                                                   VerticalAlignment="Top"
                                                   Visibility="{Binding IsNotRenaming, Converter={StaticResource BoolToVis}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBox x:Name="ItemRenameBox"
                                                 Text="{Binding RenameBuffer, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InlineEdit}"
                                                 TextAlignment="Center" FontSize="12"
                                                 Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}"
                                                 IsVisibleChanged="RenameBox_IsVisibleChanged"
                                                 KeyDown="RenameBox_KeyDown" LostFocus="RenameBox_LostFocus" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                        <ListBox.ContextMenu>
                            <ContextMenu x:Name="TileMenu" Opened="TileMenu_Opened">
                                <MenuItem x:Name="OpenMenu" Header="打开" Click="Open_Click" />
                                <MenuItem x:Name="RevealMenu" Header="在资源管理器中显示" Click="Reveal_Click" />
                                <Separator Style="{StaticResource MenuSeparator}" />
                                <MenuItem x:Name="RenameMenu" Header="重命名" Click="Rename_Click" />
                                <MenuItem x:Name="EditPathMenu" Header="编辑路径" Click="EditPath_Click" />
                                <MenuItem x:Name="SendToMenu" Header="发送到其他分组" />
                                <MenuItem x:Name="RemoveMenu" Header="移除" Click="Remove_Click" />
                                <Separator Style="{StaticResource MenuSeparator}" />
                                <MenuItem x:Name="OpenParentMenu" Header="打开所在目录" Click="OpenParent_Click" />
                                <MenuItem x:Name="CopyPathMenu" Header="复制路径" Click="CopyPath_Click" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>

                    <!-- 空状态 -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedItems.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="把文件或文件夹拖到这里" FontSize="15" Foreground="#98A2B3" TextAlignment="Center" />
                        <TextBlock Text="也可以点下方“导入文件 / 导入文件夹”" FontSize="12" Foreground="#B4BCCA"
                                   TextAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ 底部工具条 ============ -->
            <Grid Grid.Row="2" Margin="10,0,10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="导入文件" Click="ImportFiles_Click" Style="{StaticResource BarButton}" />
                <Button Grid.Column="1" Content="导入文件夹" Click="ImportFolders_Click" Style="{StaticResource BarButton}" />
                <Button Grid.Column="2" Content="刷新" Click="Refresh_Click" Style="{StaticResource BarButton}"
                        ToolTip="重新读取图标与路径状态" />

                <TextBlock Grid.Column="3" Text="{Binding StatusText}" Foreground="{StaticResource Muted}" FontSize="12"
                           VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis" />

                <!-- 窗口收窄到 600：这条提示要短，否则会把中间的状态文字挤没 -->
                <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="11" Foreground="#AAB2C0"
                           Text="Ctrl 多选 · 右键更多"
                           ToolTip="分组标签和磁贴都可以拖拽排序；按住 Ctrl / Shift 点磁贴可多选，按 Delete 或右键 → 移除可一次删掉多个（不会删除磁盘文件）" />
            </Grid>
        </Grid>
    </Border>
</Window>
