<Window x:Class="ShortcutManager.PathEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑路径"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F6FA"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        Foreground="#1F2430">
    <Border Margin="14">
        <StackPanel>
            <TextBlock Text="新的文件 / 文件夹路径（可粘贴，也可用浏览按钮选择）："
                       Foreground="#3B4457" Margin="0,0,0,8" />

            <TextBox x:Name="PathBox"
                     Height="30" VerticalContentAlignment="Center"
                     Padding="8,0" Background="White" BorderBrush="#D8DEEA" BorderThickness="1"
                     KeyDown="PathBox_KeyDown" />

            <TextBlock Text="位于程序目录内的路径会以相对路径保存，方便整个文件夹迁移。"
                       Foreground="#7A869A" FontSize="12" Margin="0,6,0,0" />

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="浏览文件…" Click="BrowseFile_Click"
                        Padding="12,5" Margin="0,0,6,0" Cursor="Hand" />
                <Button Grid.Column="1" Content="浏览文件夹…" Click="BrowseFolder_Click"
                        Padding="12,5" Margin="0,0,6,0" Cursor="Hand" />

                <Button Grid.Column="3" Content="确定" Click="Ok_Click" IsDefault="True"
                        Padding="16,5" Margin="0,0,6,0" Cursor="Hand"
                        Background="#2F6FED" Foreground="White" BorderThickness="0" />
                <Button Grid.Column="4" Content="取消" IsCancel="True"
                        Padding="16,5" Cursor="Hand" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
